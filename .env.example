# ====================================================
# HAQI-SMART — Environment Variables
# Copy to .env and fill in real values
# ====================================================

# --- Database (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql+asyncpg://haqi:haqi_password@db:5432/haqi

# --- External ML Server (NOT in docker-compose — external service) ---
ML_SERVER_URL=http://localhost:9000

# --- JWT Authentication ---
SECRET_KEY=replace-this-with-a-real-256-bit-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL container settings (used by docker-compose) ---
POSTGRES_DB=haqi
POSTGRES_USER=haqi
POSTGRES_PASSWORD=haqi_password

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
