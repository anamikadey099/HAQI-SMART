# ---------------------------------------------------------------------
# HAQI-SMART — example environment file
# Copy this to .env and fill in real values before running locally.
# NEVER commit .env to source control.
# ---------------------------------------------------------------------

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/haqi_smart

# ML microservice (deployed independently — not in Docker Compose)
ML_SERVER_URL=http://localhost:8001

# Auth  — change JWT_SECRET_KEY to a long random string in production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# App
APP_ENV=development
LOG_LEVEL=INFO
